# Copy to .env and edit. Secrets (passwords, keys, tokens) live in deploy/secrets/, not here.

# Public address of the site. A real domain gets an automatic TLS certificate.
# For a LAN-only install use ":80" (and put TLS in front, or accept plain HTTP on the private network).
SITE_ADDRESS=chador.example.ir
ACME_EMAIL=admin@example.ir

# Where the PWA build output is mounted from
PWA_DIR=./pwa

# Image tag for the API/worker, and base-image overrides (use a private registry/mirror if Docker Hub is blocked)
VERSION=local
# GO_IMAGE=registry.example.ir/library/golang:1.26-alpine
# RUNTIME_IMAGE=registry.example.ir/distroless/static-debian12:nonroot
# POSTGRES_IMAGE=registry.example.ir/library/postgres:16-alpine
# REDIS_IMAGE=registry.example.ir/library/redis:7-alpine
# CADDY_IMAGE=registry.example.ir/library/caddy:2-alpine

# External services. Production refuses to start with "mock".
INQUIRY_MODE=http
INQUIRY_URL=https://inquiry.vendor.example/verify
SMS_MODE=http
SMS_URL=https://sms.vendor.example/send

# Business policy
ALLOW_UNVERIFIED=false   # true = allow hand-outs while the inquiry service is down (identity checked later)
UNDO_WINDOW=3m           # how long a server may cancel their own hand-out
REMINDER_AFTER=6h        # first reminder SMS for tents not returned
MAX_REMINDERS=2
RETENTION_DAYS=90        # personal data of inactive pilgrims is erased after this
